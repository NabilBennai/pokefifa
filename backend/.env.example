# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JWT_SECRET=change-this-in-real-env
JWT_EXPIRES_IN=15m

# Game
STARTER_PACK_SLUG=bronze_pack
STARTER_PACK_COUNT=5
PACK_OPEN_CREATURE_REWARDS=5
PACK_OPEN_ITEM_REWARDS=1
SEASON_REWARD_PACK_SLUG=silver_pack
RANKED_SEASON_ID=2026-S1
RANKED_SEASON_START=2026-01-01T00:00:00.000Z
RANKED_SEASON_END=2026-12-31T23:59:59.000Z
RANKED_ADMIN_KEY=change-me-admin-reset-key

# PostgreSQL (docker-compose.dev.yml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pokefifa
DATABASE_USER=pokefifa
DATABASE_PASSWORD=pokefifa
DATABASE_URL=postgresql://pokefifa:pokefifa@localhost:5432/pokefifa

# Mail (MailDev in docker-compose.dev.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@pokefifa.local

# MailDev UI
MAILDEV_WEB_URL=http://localhost:1080
